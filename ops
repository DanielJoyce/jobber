{"author":{"id":"337a442880d7106d509ff84f2f7fef51acce8bce88b081d4f4c3f0298b7e7941"},"ops":[{"type":3,"timestamp":1791688590,"nonce":"bKgHTQ1ALLp1Sbax8JmZ4CUipe0=","message":"Decision: 7 daily + 4 weekly counts the last 7 UTC days and last 4 ISO weeks that HAVE an automatic backup (restic keep-daily/keep-weekly semantics), union kept, max 11 files; a stamp more than a day in the future is kept and takes no slot; a name matching the regex but not a real date is never deleted; symlinks and directories are skipped. Reason: calendar-window counting would prune down to zero after the machine is off for a few weeks, and a bad clock must not push real backups out.","files":null}]}