# Template for `jobhunter schedule install`; paths are filled in when the units are written.
[Unit]
Description=jobhunter nightly run (ingest stages through score submit)
OnFailure=jobhunter-notify@%n.service

[Service]
Type=oneshot
# The checkout is the working directory for .env (and the legacy ./data fallback). The
# database, profile and cache live under XDG_DATA_HOME / XDG_CACHE_HOME (jobhunter paths).
WorkingDirectory=@REPO@
ExecStart=@EXEC@ run
Nice=10
Environment=PATH=@PATH@
