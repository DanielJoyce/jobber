# Template for `jobhunter schedule install`; paths are filled in when the units are written.
[Unit]
Description=jobhunter nightly run (ingest stages through score submit)
OnFailure=jobhunter-notify@%n.service

[Service]
Type=oneshot
# The checkout is the working directory only so ./.env is read. The config, database,
# profile and cache live under the XDG directories below, pinned to what the shell resolved
# at `jobhunter schedule install` time so the timers use the same files as `jobhunter paths`
# (the systemd user manager may not see XDG_* set in a login shell). Reinstall after changing
# them.
WorkingDirectory=@REPO@
ExecStart=@EXEC@ run
Nice=10
Environment=PATH=@PATH@
@XDG_ENV@
