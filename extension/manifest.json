{
  "manifest_version": 3,
  "name": "jobhunter",
  "description": "Send the job posting you are viewing to your local jobhunter console. Reads a page only when you click.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Send to jobhunter", "default_popup": "popup/index.html"},
  "options_ui": {"page": "options/index.html", "open_in_tab": true},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+J"},
      "description": "Send this job page to jobhunter"
    }
  }
}
