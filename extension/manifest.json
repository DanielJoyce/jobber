{
  "manifest_version": 3,
  "name": "jobhunter",
  "description": "Send job postings to your local jobhunter console and fill application forms on your click. Never submits.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*"
  ],
  "optional_host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*"
      ],
      "js": ["content/frame.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": false,
      "world": "ISOLATED"
    }
  ],
  "side_panel": {"default_path": "panel/index.html"},
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Send to jobhunter", "default_popup": "popup/index.html"},
  "options_ui": {"page": "options/index.html", "open_in_tab": true},
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+J"},
      "description": "Send this job page to jobhunter"
    }
  }
}
