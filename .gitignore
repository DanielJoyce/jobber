# Personal data — never commit (this repository is public).
# resume/ has contact details; profile/ holds salary targets. Both stay local.
resume/
profile/
config.toml
*.local.toml

# Runtime data: SQLite DB, raw HTTP cache, inbox drops
data/
!specs/data/

# Old folders that `jobhunter migrate-paths --apply` renamed in place (data.migrated-YYYYMMDD
# and so on). They still hold the DB, backups, contact details and salary targets.
data.migrated-*/
profile.migrated-*/
resume.migrated-*/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Secrets
.env
*.pem
token*.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Agent worktrees
.claude/worktrees/
