# Same schedule as the host timers from `jobhunter schedule install` (tested to match).
# Install to ~/.config/systemd/user/, then enable --now.
[Unit]
Description=Nightly jobhunter run at 02:00 (container)

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
RandomizedDelaySec=10m
Unit=jobhunter-ctr-run.service

[Install]
WantedBy=timers.target
