# Base unit (specs/018, C4). No Secret= lines: `jobhunter container preflight` writes one
# drop-in per secret in jobhunter-console.container.d/. Install to ~/.config/containers/systemd/.
[Unit]
Description=jobhunter console (127.0.0.1:8808)
OnFailure=jobhunter-ctr-notify@%n.service

[Container]
Image=localhost/jobhunter:current
ContainerName=jobhunter-console
UserNS=keep-id:uid=1000,gid=1000
Timezone=local
Volume=%h/.local/share/jobhunter:/data:z
Volume=%h/.cache/jobhunter:/cache:z
Volume=%h/.config/jobhunter/config.toml:/config/config.toml:ro,z
Environment=JOBHUNTER_DATA_DIR=/data
Environment=JOBHUNTER_DB_PATH=/data/jobhunter.db
Environment=JOBHUNTER_PROFILE_DIR=/data/profile
Environment=JOBHUNTER_RESUME_PATH=/data/resume
Environment=JOBHUNTER_CACHE_DIR=/cache
# Console Restart (specs/019 S12b): the console exits 42 to be restarted with a fresh mount.
Environment=JOBHUNTER_RESTART_EXIT=42
Network=pasta:--host-lo-to-ns-lo
PublishPort=127.0.0.1:8808:8808
Exec=console --host 127.0.0.1 --port 8808
# /healthz needs a loopback Host header (C1); the image has no curl, so use python.
HealthCmd=python -c "import urllib.request as u; u.urlopen(u.Request('http://127.0.0.1:8808/healthz', headers={'Host': '127.0.0.1:8808'}), timeout=3)"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill

[Service]
Restart=on-failure
# Exit 42 is the console's Restart: start it again, and do not count it as a failure (no
# OnFailure= notification).
SuccessExitStatus=42
RestartForceExitStatus=42
ExecStartPre=/usr/bin/mkdir -p -m 0700 %h/.local/share/jobhunter %h/.cache/jobhunter

[Install]
WantedBy=default.target
